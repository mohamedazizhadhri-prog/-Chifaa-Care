{
  "name": "rami-server",
  "version": "1.0.0",
  "description": "Backend server for Rami Discord Activity",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r dotenv/config src/index.ts",
    "dev:simple": "node --loader ts-node/esm --require dotenv/config src/index.ts",
    "dev:tsx": "tsx watch --require dotenv/config src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "ts-node src/migrate.ts up",
    "migrate:down": "ts-node src/migrate.ts down",
    "migrate:status": "ts-node src/migrate.ts status",
    "db:setup": "ts-node src/setup-db.ts",
    "db:migrate": "node-pg-migrate up",
    "db:migrate:down": "node-pg-migrate down",
    "db:migrate:create": "node-pg-migrate create",
    "test": "jest",
    "lint": "eslint . --ext .ts"
  },
  "keywords": ["discord", "activity", "game", "rami"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.6.1",
    "pg": "^8.11.0",
    "redis": "^4.6.7",
    "dotenv": "^16.0.3",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.0",
    "discord-interactions": "^3.4.0",
    "node-pg-migrate": "^6.2.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.2.5",
    "@types/pg": "^8.10.2",
    "@types/cors": "^2.8.13",
    "@types/jsonwebtoken": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "eslint": "^8.42.0",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.1.3",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "socket.io-client": "^4.6.1",
    "@types/jest": "^29.5.2",
    "@types/uuid": "^9.0.0"
  }
}
