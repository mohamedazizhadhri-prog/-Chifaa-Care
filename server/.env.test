# Test Environment - No Database Required
PORT=3001
NODE_ENV=development

# Discord Configuration (optional for local testing)
DISCORD_CLIENT_ID=test_client_id
DISCORD_CLIENT_SECRET=test_secret
DISCORD_PUBLIC_KEY=test_public_key

# Leave these EMPTY to skip database/redis
DATABASE_URL=
REDIS_URL=

# JWT Secret
JWT_SECRET=test_secret_key_123

# CORS
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
