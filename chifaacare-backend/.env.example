# Database
DATABASE_URL="postgresql://username:password@localhost:5432/chifaacare?schema=public"

# JWT
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN="7d"

# Encryption (HIPAA/GDPR Compliance)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="your_256_bit_encryption_key_here_64_hex_characters"

# Auth0 (OAuth2)
AUTH0_DOMAIN="your-tenant.auth0.com"
AUTH0_AUDIENCE="https://your-api-identifier"
AUTH0_CLIENT_ID="your_auth0_client_id"
AUTH0_CLIENT_SECRET="your_auth0_client_secret"

# Server
PORT=3000
NODE_ENV="development"

# Optional: Elasticsearch for Audit Logs
ELASTICSEARCH_URL="http://localhost:9200"
ELASTICSEARCH_API_KEY="your_elasticsearch_api_key"
