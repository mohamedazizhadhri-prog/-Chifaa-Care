{
  "name": "chifaacare-homepage",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "backend": "cd chifaacare-backend && npm run dev",
    "backend:start": "cd chifaacare-backend && npm start",
    "db:setup": "cd chifaacare-backend && npm run prisma:generate && npm run migrate:deploy",
    "db:studio": "cd chifaacare-backend && npm run prisma:studio",
    "db:test": "cd chifaacare-backend && npm run test:neon",
    "setup": "npm install && cd chifaacare-backend && npm install && cd .. && npm run db:setup",
    "start:all": "start-all.bat"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^17.3.12",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.3.12",
    "@angular/forms": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.3.12",
    "@angular/service-worker": "^17.3.12",
    "@auth0/auth0-angular": "^2.3.0",
    "@fortawesome/angular-fontawesome": "^0.14.0",
    "@fortawesome/fontawesome-free": "^6.5.0",
    "@fortawesome/fontawesome-svg-core": "^6.5.0",
    "@fortawesome/free-solid-svg-icons": "^6.5.0",
    "@ng-bootstrap/ng-bootstrap": "^16.0.0",
    "@popperjs/core": "^2.11.8",
    "@stripe/stripe-js": "^8.2.0",
    "@types/date-fns": "^2.5.3",
    "bootstrap": "^5.3.8",
    "bootstrap-icons": "^1.13.1",
    "date-fns": "^4.1.0",
    "engine.io-client": "^6.6.3",
    "gsap": "^3.12.0",
    "primeicons": "^7.0.0",
    "primeng": "^17.0.0",
    "rxjs": "~7.8.0",
    "socket.io-client": "^4.8.1",
    "three": "^0.158.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.14.0"
  },
